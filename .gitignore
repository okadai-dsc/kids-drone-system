# 6月中は別管理（保留事項）
Scratch/

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Tello 関連の出力・スナップショット
tello/.tellomon.py.sw*
tello/tellomon.py.[0-9]*

# docs は PDF・設計書・計画書など重量物を除外し、セットアップ/開発系の .md だけ追跡する
# 設計書・計画書・PDF・図は手元 or 外部（Drive 等）で管理する
docs/*
!docs/development.md
!docs/demo.md
!docs/network-setup.md
!docs/raspi-setup.md
!docs/yolopc-setup.md
!docs/.gitkeep
*.pt
.claude/settings.local.json